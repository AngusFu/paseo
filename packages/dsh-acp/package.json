{
  "name": "@getpaseo/dsh-acp",
  "version": "0.1.106",
  "description": "ACP adapter for DeepSeek Harness",
  "bin": {
    "dsh-acp": "dist/cli.js"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
