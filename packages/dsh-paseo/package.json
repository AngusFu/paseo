{
  "name": "dsh-paseo",
  "version": "0.2.0",
  "private": true,
  "description": "Paseo-aligned DSH tooling: CLI + MCP + host RPCs + Desktop embed client",
  "bin": {
    "dsh-paseo": "./src/cli/index.js",
    "dsh-paseo-mcp": "./src/mcp/server.js"
  },
  "type": "module",
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./host": "./src/host/index.js",
    "./client": "./src/client/index.js",
    "./mcp": "./src/mcp/server.js",
    "./cli": "./src/cli/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node ./src/mcp/server.js",
    "smoke": "node ./src/mcp/smoke.js",
    "cli": "node ./src/cli/index.js",
    "test:host": "node ./src/host/smoke-plugin.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "mnemonic-id": "^3.2.7",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "sessions",
        "workspaces",
        "layout"
      ],
      "platform": "web"
    }
  }
}
